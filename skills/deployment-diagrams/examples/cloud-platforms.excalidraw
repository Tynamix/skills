    {
      "id": "v2-notes",
      "type": "text",
      "x": 1600,
      "y": 1176,
      "width": 1408,
      "height": 48,
      "text": "Scope: Multi-AZ DB instance, not a read-replica design. ALB public subnets in both zones, routing, SGs and DNS are omitted.\nAZ = availability zone; RDS = Relational Database Service; SG = security group. Clients never use the standby.",
      "fontSize": 16,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "autoResize": false,
      "textAlign": "left",
      "strokeColor": "#1e293b",
      "groupIds": [],
      "version": 2,
      "versionNonce": 1907118184,
      "index": "b0p",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1792605001075,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scope: Multi-AZ DB instance, not a read-replica design. ALB public subnets in both zones, routing, SGs and DNS are omitted.\nAZ = availability zone; RDS = Relational Database Service; SG = security group. Clients never use the standby."
    },
    {
      "id": "v2-legend",
      "type": "text",
      "x": 1600,
      "y": 1256,
      "width": 1408,
      "height": 32,
      "text": "Legend: solid arrows = requests; dot = shared SQL path, not a proxy; dashed arrow = primary-to-standby replication.",
      "fontSize": 16,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "autoResize": false,
      "textAlign": "left",
